// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (Global)
// ============================================================================

enum Phase {
  Inception
  Elaboration
  Construction
  Transition
}

enum TemplateCategory {
  Standard
  Simplified
  Agile
  Custom
}

enum TemplateStatus {
  Draft
  Published
  Archived
  ValidationFailed
}

enum EdgeType {
  required
  optional
}

enum NodeStatus {
  locked
  available
  in_progress
  ready
}

enum DocumentStatus {
  draft
  completed
}

enum AIDraftStatus {
  pending
  accepted
  previously_used
  rejected
}

enum DraftGenType {
  initial_draft
  conversation_refinement
  rejection_regeneration
}

enum TaskStatus {
  pending
  running
  completed
  failed
}

enum AlertSource {
  impact_analysis
  rollback_detection
}

enum AlertStatus {
  pending
  handled
  ignored
  archived
}

enum UpstreamActionType {
  SupplementNewDocs
  ReviseExistingDocs
}

enum JobStatus {
  scheduled
  running
  completed
  failed
  cancelled
}

enum IssueSeverity {
  error
  warning
  info
}

enum IssueType {
  phase_invalid
  circular_dependency
  orphaned_node
  missing_doctype
  invalid_edge
  workflow_empty
}

enum UserRole {
  admin
  project_manager
  developer
  reviewer
  viewer
}

// ============================================================================
// TEMPLATE BOUNDED CONTEXT
// ============================================================================

model RUPTemplate {
  id                   String                @id @default(uuid())
  name                 String                @db.VarChar(100)
  description          String?               @db.Text
  category             TemplateCategory      @default(Standard)
  estimatedDuration    String?               @db.VarChar(50)
  status               TemplateStatus        @default(Draft)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Relations
  config               TemplateConfig?
  workflows            WorkflowDefinition[]
  crossFlowDependencies CrossFlowDependency[]
  validationIssues     ValidationIssue[]
  projects             Project[]
  flowInstances        FlowInstance[]

  // Indexes
  @@index([status])
  @@index([category])
  @@index([createdAt])

  @@map("rup_templates")
}

model TemplateConfig {
  id                   String       @id @default(uuid())
  templateId           String       @unique
  maxDepth             Int          @default(5)
  autoValidateOnSave   Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  template             RUPTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_configs")
}

model ValidationIssue {
  id           String         @id @default(uuid())
  templateId   String
  workflowId   String?
  nodeId       String?
  severity     IssueSeverity
  type         IssueType
  message      String         @db.Text
  details      Json?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  // Relations
  template     RUPTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([templateId, resolvedAt])
  @@index([severity])
  @@index([type])

  @@map("validation_issues")
}

model WorkflowDefinition {
  id                String              @id @default(uuid())
  rupTemplateId     String
  name              String              @db.VarChar(100)
  code              String              @db.VarChar(50)
  priority          Int                 @default(0)
  estimatedDuration String?             @db.VarChar(50)
  description       String?             @db.Text
  phases            Phase[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  rupTemplate       RUPTemplate         @relation(fields: [rupTemplateId], references: [id], onDelete: Cascade)
  nodes             FlowTemplateNode[]
  edges             FlowTemplateEdge[]
  workflowInstances WorkflowInstance[]

  // Indexes
  @@index([rupTemplateId])
  @@index([code])
  @@unique([rupTemplateId, code])

  @@map("workflow_definitions")
}

model FlowTemplateNode {
  id                    String              @id @default(uuid())
  workflowDefinitionId  String
  fullId                String              @unique
  docTypeId             String
  label                 String              @db.VarChar(100)
  description           String?             @db.Text
  phase                 Phase
  workflow              String              @db.VarChar(50)
  priority              Int                 @default(0)
  estimatedDuration     String?             @db.VarChar(50)
  positionX             Int                 @default(0)
  positionY             Int                 @default(0)
  completionCondition   Json
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  workflowDefinition    WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  docType               DocType             @relation(fields: [docTypeId], references: [id])
  sourceEdges           FlowTemplateEdge[]  @relation("EdgeSource")
  targetEdges           FlowTemplateEdge[]  @relation("EdgeTarget")

  // Indexes
  @@index([workflowDefinitionId])
  @@index([docTypeId])
  @@index([phase])

  @@map("flow_template_nodes")
}

model FlowTemplateEdge {
  id                    String              @id @default(uuid())
  workflowDefinitionId  String
  source                String
  target                String
  type                  EdgeType            @default(required)
  label                 String?             @db.VarChar(100)
  weight                Int                 @default(1)
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  workflowDefinition    WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  sourceNode            FlowTemplateNode    @relation("EdgeSource", fields: [source], references: [fullId], onDelete: Cascade)
  targetNode            FlowTemplateNode    @relation("EdgeTarget", fields: [target], references: [fullId], onDelete: Cascade)

  // Indexes
  @@index([workflowDefinitionId])
  @@index([source])
  @@index([target])
  @@index([source, target])
  @@unique([workflowDefinitionId, source, target])

  @@map("flow_template_edges")
}

model CrossFlowDependency {
  id                String        @id @default(uuid())
  rupTemplateId     String
  sourceWorkflowId  String
  sourceNodeId      String
  sourceFullId      String
  targetWorkflowId  String
  targetNodeId      String
  targetFullId      String
  type              EdgeType      @default(required)
  displayLabel      String?       @db.VarChar(200)
  description       String?       @db.Text
  weight            Int           @default(1)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  rupTemplate       RUPTemplate   @relation(fields: [rupTemplateId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([rupTemplateId])
  @@index([sourceFullId])
  @@index([targetFullId])
  @@unique([rupTemplateId, sourceFullId, targetFullId])

  @@map("cross_flow_dependencies")
}

// ============================================================================
// PROJECT FLOW BOUNDED CONTEXT
// ============================================================================

model Project {
  id                String          @id @default(uuid())
  name              String          @db.VarChar(100)
  description       String?         @db.Text
  rupTemplateId     String
  currentPhase      Phase           @default(Inception)
  ownerId           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  rupTemplate       RUPTemplate     @relation(fields: [rupTemplateId], references: [id])
  owner             User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  flowInstance      FlowInstance?

  // Indexes
  @@index([rupTemplateId])
  @@index([currentPhase])
  @@index([ownerId])
  @@index([createdAt])

  @@map("projects")
}

model FlowInstance {
  id                String              @id @default(uuid())
  projectId         String              @unique
  rupTemplateId     String
  createdAt         DateTime            @default(now())

  // Relations
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rupTemplate       RUPTemplate         @relation(fields: [rupTemplateId], references: [id])
  workflowInstances WorkflowInstance[]

  // Indexes
  @@index([rupTemplateId])

  @@map("flow_instances")
}

model WorkflowInstance {
  id                    String              @id @default(uuid())
  flowInstanceId        String
  workflowDefinitionId  String
  workflowName          String              @db.VarChar(100)
  workflowCode          String              @db.VarChar(50)
  totalNodes            Int                 @default(0)
  completedNodes        Int                 @default(0)
  createdAt             DateTime            @default(now())

  // Relations
  flowInstance          FlowInstance        @relation(fields: [flowInstanceId], references: [id], onDelete: Cascade)
  workflowDefinition    WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id])
  nodeInstances         NodeInstance[]

  // Indexes
  @@index([flowInstanceId])
  @@index([workflowDefinitionId])

  @@map("workflow_instances")
}

model NodeInstance {
  id                        String              @id @default(uuid())
  workflowInstanceId        String
  templateNodeId            String
  fullTemplateNodeId        String
  docTypeId                 String
  label                     String              @db.VarChar(100)
  description               String?             @db.Text
  phase                     Phase
  priority                  Int                 @default(0)
  status                    NodeStatus          @default(locked)
  documentIds               String[]
  documentCount             Int                 @default(0)
  completedDocumentCount    Int                 @default(0)
  completionConditionSnapshot Json
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime            @default(now())

  // Relations
  workflowInstance          WorkflowInstance    @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  docType                   DocType             @relation(fields: [docTypeId], references: [id])
  prerequisites             Prerequisite[]      @relation("NodePrerequisites")
  dependentNodes            Prerequisite[]      @relation("PrerequisiteOf")
  documents                 Document[]
  regenerationAlerts        RegenerationAlert[]
  upstreamAlerts            UpstreamClarificationAlert[]

  // Indexes
  @@index([workflowInstanceId])
  @@index([status])
  @@index([docTypeId])
  @@index([fullTemplateNodeId])

  @@map("node_instances")
}

model Prerequisite {
  id                        String        @id @default(uuid())
  nodeInstanceId            String
  prerequisiteNodeInstanceId String
  fullTemplateNodeId        String
  satisfied                 Boolean       @default(false)
  type                      EdgeType      @default(required)
  createdAt                 DateTime      @default(now())

  // Relations
  nodeInstance              NodeInstance  @relation("NodePrerequisites", fields: [nodeInstanceId], references: [id], onDelete: Cascade)
  prerequisiteNode          NodeInstance  @relation("PrerequisiteOf", fields: [prerequisiteNodeInstanceId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([nodeInstanceId])
  @@index([prerequisiteNodeInstanceId])
  @@unique([nodeInstanceId, prerequisiteNodeInstanceId])

  @@map("prerequisites")
}

// ============================================================================
// DOCUMENTING BOUNDED CONTEXT
// ============================================================================

model Document {
  id                String              @id @default(uuid())
  nodeInstanceId    String
  name              String              @db.VarChar(200)
  content           String              @db.Text @default("")
  status            DocumentStatus      @default(draft)
  currentVersion    String?             @db.VarChar(20)
  inputDocuments    Json                @db.JsonB @default(dbgenerated("'[]'::jsonb"))
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  lastModifiedBy    String?

  // Relations
  nodeInstance      NodeInstance        @relation(fields: [nodeInstanceId], references: [id], onDelete: Cascade)
  creator           User?               @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  modifier          User?               @relation("DocumentModifier", fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]
  aiDrafts          AIDraft[]
  conversationSessions ConversationSession[]

  // Indexes
  @@index([nodeInstanceId])
  @@index([status])
  @@index([createdBy])
  @@index([lastModifiedBy])
  @@index([createdAt])

  @@map("documents")
}

model DocumentVersion {
  id                String        @id @default(uuid())
  documentId        String
  version           String        @db.VarChar(20)
  content           String        @db.Text
  summary           String        @db.Text
  aiDraftId         String?
  triggeredBy       Json          @default("[]")
  isRollback        Boolean       @default(false)
  rollbackFrom      String?       @db.VarChar(20)
  rollbackChain     Json?
  skipImpactAnalysis Boolean      @default(false)
  createdAt         DateTime      @default(now())

  // Relations
  document          Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([documentId])
  @@index([version])
  @@index([createdAt])
  @@unique([documentId, version])

  @@map("document_versions")
}

model AIDraft {
  id                    String              @id
  documentId            String
  name                  String              @db.VarChar(200)
  status                AIDraftStatus       @default(pending)
  content               String              @db.Text
  conversationSessionId String
  autoGenerated         Boolean             @default(false)
  rejectionReason       String?             @db.Text
  rejectedBy            String?
  associatedVersions    String[]            @default([])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  acceptedAt            DateTime?
  rejectedAt            DateTime?

  // Relations
  document              Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  conversationSession   ConversationSession @relation(fields: [conversationSessionId], references: [id])
  rejecter              User?               @relation("DraftRejecter", fields: [rejectedBy], references: [id], onDelete: SetNull)
  generationMeta        DraftGenerationMeta?

  // Indexes
  @@index([documentId])
  @@index([status])
  @@index([conversationSessionId])
  @@index([rejectedBy])
  @@index([documentId, status])
  @@index([createdAt])

  @@map("ai_drafts")
}

model AIDraftSequence {
  id          String   @id @default("global")
  nextNumber  BigInt   @default(1)
  lastUpdated DateTime @updatedAt

  @@map("ai_draft_sequence")
}

model ConversationSession {
  id                    String              @id @default(uuid())
  documentId            String
  name                  String              @db.VarChar(100)
  aiRole                String              @db.VarChar(100)
  backgroundTaskStatus  String              @default("idle")
  lastGeneratedAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  document              Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages              AIMessage[]
  aiDrafts              AIDraft[]
  backgroundTasks       BackgroundGenerationTask[]

  // Indexes
  @@index([documentId])
  @@index([createdAt])

  @@map("conversation_sessions")
}

model AIMessage {
  id                    String              @id @default(uuid())
  conversationSessionId String
  role                  String              @db.VarChar(20)
  content               String              @db.Text
  timestamp             DateTime            @default(now())

  // Relations
  conversationSession   ConversationSession @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([conversationSessionId])
  @@index([timestamp])

  @@map("ai_messages")
}

model DraftGenerationMeta {
  id                    String              @id @default(uuid())
  draftId               String              @unique
  conversationSessionId String
  type                  DraftGenType
  inputDocuments        Json                @default("[]")
  createdAt             DateTime            @default(now())

  // Relations
  draft                 AIDraft             @relation(fields: [draftId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([type])
  @@index([createdAt])

  @@map("draft_generation_meta")
}

model BackgroundGenerationTask {
  id                    String              @id @default(uuid())
  conversationSessionId String
  triggeredBy           String              @db.VarChar(50)
  triggerMessage        String              @db.Text
  status                TaskStatus          @default(pending)
  generatedDraftIds     String[]            @default([])
  createdAt             DateTime            @default(now())
  completedAt           DateTime?
  errorMessage          String?             @db.Text

  // Relations
  conversationSession   ConversationSession @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([conversationSessionId])
  @@index([status])
  @@index([createdAt])

  @@map("background_generation_tasks")
}

// ============================================================================
// IMPACT ALERT BOUNDED CONTEXT
// ============================================================================

model RegenerationAlert {
  id                String        @id @default(uuid())
  nodeId            String
  triggeredBy       Json
  changes           Json
  affectedDocuments Json
  impactAssessment  Json?
  createdBy         AlertSource   @default(impact_analysis)
  status            AlertStatus   @default(pending)
  createdAt         DateTime      @default(now())
  handledAt         DateTime?
  ignoredAt         DateTime?
  ignoreReason      String?       @db.Text
  restoredAt        DateTime?

  // Relations
  node              NodeInstance  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([nodeId])
  @@index([status])
  @@index([createdAt])

  @@map("regeneration_alerts")
}

model UpstreamClarificationAlert {
  id                String              @id @default(uuid())
  nodeId            String
  actionType        UpstreamActionType
  triggeredBy       Json
  suggestedDocuments Json?
  affectedDocuments Json?
  issueType         String?             @db.VarChar(50)
  description       String              @db.Text
  suggestions       String              @db.Text
  impactAssessment  Json?
  status            AlertStatus         @default(pending)
  createdAt         DateTime            @default(now())
  handledAt         DateTime?
  ignoredAt         DateTime?
  ignoreReason      String?             @db.Text
  restoredAt        DateTime?

  // Relations
  node              NodeInstance        @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([nodeId])
  @@index([status])
  @@index([actionType])
  @@index([createdAt])

  @@map("upstream_clarification_alerts")
}

// ============================================================================
// GOVERNANCE BOUNDED CONTEXT
// ============================================================================

model DocType {
  id                String              @id @db.VarChar(50)
  name              String              @db.VarChar(100)
  code              String              @db.VarChar(50)
  workflow          String              @db.VarChar(100)
  category          String              @db.VarChar(50)
  description       String?             @db.Text
  template          String?             @db.Text
  supportedFormats  String[]            @default(["markdown"])
  systemPrompt      String              @db.Text
  group             String?             @db.VarChar(50)
  priority          Int                 @default(0)
  isRequired        Boolean             @default(false)
  isActive          Boolean             @default(true)
  phases            Phase[]
  sourcesDocTypes   String[]            @default([])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  templateNodes     FlowTemplateNode[]
  nodeInstances     NodeInstance[]

  // Indexes
  @@index([workflow])
  @@index([category])
  @@index([isActive])
  @@unique([code])

  @@map("doc_types")
}

model PhaseMapping {
  id             String   @id @default(uuid())
  workflowCode   String   @unique
  allowedPhases  Phase[]
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workflowCode])

  @@map("phase_mappings")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  fullName      String    @db.VarChar(100)
  role          UserRole  @default(developer)
  department    String?   @db.VarChar(100)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  ownedProjects         Project[]   @relation("ProjectOwner")
  createdDocuments      Document[]  @relation("DocumentCreator")
  modifiedDocuments     Document[]  @relation("DocumentModifier")
  rejectedDrafts        AIDraft[]   @relation("DraftRejecter")

  // Indexes
  @@index([email])
  @@index([isActive])
  @@index([role])
  @@index([isActive, role])

  @@map("users")
}

model AIServiceConfig {
  id                String        @id @default(uuid())
  name              String        @db.VarChar(100)
  provider          String        @db.VarChar(50)
  model             String        @db.VarChar(100)
  apiKey            String        @db.VarChar(500)
  apiEndpoint       String        @db.VarChar(500)
  temperature       Float         @default(0.7)
  maxTokens         Int           @default(4000)
  timeoutMs         Int           @default(60000)
  retryMaxAttempts  Int           @default(3)
  retryDelayMs      Int           @default(1000)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Indexes
  @@index([isActive])

  @@map("ai_service_configs")
}

model ArchivePolicy {
  id                        String        @id @default(uuid())
  name                      String        @db.VarChar(100)
  archiveDaysAfterHandled   Int           @default(30)
  archiveDaysAfterIgnored   Int           @default(30)
  cronExpression            String        @db.VarChar(100)
  batchSize                 Int           @default(100)
  isActive                  Boolean       @default(true)
  retentionDays             Int           @default(365)
  deleteAfterArchive        Boolean       @default(false)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  // Relations
  archiveJobs               ArchiveJob[]

  // Indexes
  @@index([isActive])

  @@map("archive_policies")
}

model ArchiveJob {
  id                String          @id @default(uuid())
  policyId          String
  status            JobStatus       @default(scheduled)
  startedAt         DateTime?
  completedAt       DateTime?
  processedCount    Int             @default(0)
  archivedCount     Int             @default(0)
  errorCount        Int             @default(0)
  errorMessage      String?         @db.Text
  nextScheduledAt   DateTime?

  // Relations
  policy            ArchivePolicy   @relation(fields: [policyId], references: [id])

  // Indexes
  @@index([policyId])
  @@index([status])
  @@index([nextScheduledAt])

  @@map("archive_jobs")
}