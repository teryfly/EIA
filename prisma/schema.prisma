// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Phase {
  Inception
  Elaboration
  Construction
  Transition
}

enum NodeStatus {
  locked
  available
  in_progress
  ready
}

enum DocumentStatus {
  draft
  completed
}

enum AIDraftStatus {
  pending
  accepted
  previously_used
  rejected
}

enum AlertStatus {
  pending
  handled
  ignored
  archived
}

enum EdgeType {
  required
  optional
}

enum TemplateCategory {
  Standard
  Simplified
  Agile
  Custom
}

enum TemplateStatus {
  Draft
  Published
  Archived
  ValidationFailed
}

enum AlertSource {
  impact_analysis
  rollback_detection
}

enum UpstreamActionType {
  SupplementNewDocs
  ReviseExistingDocs
}

enum DraftGenType {
  initial_draft
  conversation_refinement
  rejection_regeneration
}

enum TaskStatus {
  pending
  running
  completed
  failed
}

enum JobStatus {
  scheduled
  running
  completed
  failed
  cancelled
}

enum UserRole {
  admin
  project_manager
  developer
  reviewer
  viewer
}

enum ConfigDataType {
  string
  integer
  boolean
  json
  float
}

enum IssueSeverity {
  error
  warning
  info
}

enum IssueType {
  phase_invalid
  circular_dependency
  orphaned_node
  missing_doctype
  invalid_edge
  workflow_empty
}

enum PrerequisiteType {
  required
  optional
}

// ============================================================================
// Template BC Models
// ============================================================================

model RUPTemplate {
  id                     String                   @id @default(uuid())
  name                   String
  description            String
  category               TemplateCategory
  estimatedDuration      String?
  status                 TemplateStatus           @default(Draft)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  workflows              WorkflowDefinition[]
  crossFlowDependencies  CrossFlowDependency[]
  validationIssues       ValidationIssue[]
  projects               Project[]
  flowInstances          FlowInstance[]

  @@map("rup_templates")
}

model WorkflowDefinition {
  id                String              @id
  rupTemplateId     String
  rupTemplate       RUPTemplate         @relation(fields: [rupTemplateId], references: [id], onDelete: Cascade)
  name              String
  code              String
  phases            Phase[]
  priority          Int
  estimatedDuration String?
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  nodes             FlowTemplateNode[]
  edges             FlowTemplateEdge[]

  @@unique([rupTemplateId, code])
  @@map("workflow_definitions")
}

model FlowTemplateNode {
  id                    String              @id
  workflowDefinitionId  String
  workflowDefinition    WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  fullId                String              @unique
  docTypeId             String
  docType               DocType             @relation(fields: [docTypeId], references: [id])
  label                 String
  description           String?
  phase                 Phase
  workflow              String
  priority              Int
  estimatedDuration     String?
  positionX             Int
  positionY             Int
  completionCondition   Json
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  nodeInstances         NodeInstance[]

  @@map("flow_template_nodes")
}

model FlowTemplateEdge {
  id                    String              @id @default(uuid())
  workflowDefinitionId  String
  workflowDefinition    WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  source                String
  target                String
  type                  EdgeType
  label                 String?
  weight                Int                 @default(1)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("flow_template_edges")
}

model CrossFlowDependency {
  id                String      @id @default(uuid())
  rupTemplateId     String
  rupTemplate       RUPTemplate @relation(fields: [rupTemplateId], references: [id], onDelete: Cascade)
  sourceWorkflowId  String
  sourceNodeId      String
  sourceFullId      String
  targetWorkflowId  String
  targetNodeId      String
  targetFullId      String
  type              EdgeType
  displayLabel      String?
  description       String?
  weight            Int         @default(1)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("cross_flow_dependencies")
}

model ValidationIssue {
  id          String         @id @default(uuid())
  templateId  String
  template    RUPTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workflowId  String?
  nodeId      String?
  severity    IssueSeverity
  type        IssueType
  message     String
  details     Json
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([templateId, severity])
  @@map("validation_issues")
}

// ============================================================================
// ProjectFlow BC Models
// ============================================================================

model Project {
  id              String        @id @default(uuid())
  name            String
  description     String?
  rupTemplateId   String
  rupTemplate     RUPTemplate   @relation(fields: [rupTemplateId], references: [id])
  currentPhase    Phase
  ownerId         String?
  owner           User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  flowInstances   FlowInstance[]

  @@map("projects")
}

model FlowInstance {
  id                  String              @id @default(uuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rupTemplateId       String
  rupTemplate         RUPTemplate         @relation(fields: [rupTemplateId], references: [id])
  createdAt           DateTime            @default(now())
  workflowInstances   WorkflowInstance[]

  @@map("flow_instances")
}

model WorkflowInstance {
  id                    String        @id @default(uuid())
  flowInstanceId        String
  flowInstance          FlowInstance  @relation(fields: [flowInstanceId], references: [id], onDelete: Cascade)
  workflowDefinitionId  String
  workflowName          String
  workflowCode          String
  totalNodes            Int           @default(0)
  completedNodes        Int           @default(0)
  createdAt             DateTime      @default(now())
  nodeInstances         NodeInstance[]

  @@map("workflow_instances")
}

model NodeInstance {
  id                          String                        @id @default(uuid())
  workflowInstanceId          String
  workflowInstance            WorkflowInstance              @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  templateNodeId              String
  templateNode                FlowTemplateNode              @relation(fields: [templateNodeId], references: [id])
  fullTemplateNodeId          String
  docTypeId                   String
  label                       String
  description                 String?
  phase                       Phase
  priority                    Int
  status                      NodeStatus                    @default(locked)
  documentIds                 String[]
  documentCount               Int                           @default(0)
  completedDocumentCount      Int                           @default(0)
  completionConditionSnapshot Json
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                      @default(now())
  documents                   Document[]
  prerequisites               Prerequisite[]                @relation("NodePrerequisites")
  dependentNodes              Prerequisite[]                @relation("PrerequisiteNode")
  regenerationAlerts          RegenerationAlert[]
  upstreamAlerts              UpstreamClarificationAlert[]

  @@map("node_instances")
}

model Prerequisite {
  id                        String          @id @default(uuid())
  nodeInstanceId            String
  nodeInstance              NodeInstance    @relation("NodePrerequisites", fields: [nodeInstanceId], references: [id], onDelete: Cascade)
  prerequisiteNodeInstanceId String
  prerequisiteNode          NodeInstance    @relation("PrerequisiteNode", fields: [prerequisiteNodeInstanceId], references: [id], onDelete: Cascade)
  fullTemplateNodeId        String
  satisfied                 Boolean         @default(false)
  type                      PrerequisiteType
  createdAt                 DateTime        @default(now())

  @@map("prerequisites")
}

// ============================================================================
// Documenting BC Models
// ============================================================================

model Document {
  id                String              @id @default(uuid())
  nodeInstanceId    String
  nodeInstance      NodeInstance        @relation(fields: [nodeInstanceId], references: [id], onDelete: Cascade)
  name              String
  content           String
  status            DocumentStatus      @default(draft)
  currentVersion    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  createdByUser     User?               @relation("DocumentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  lastModifiedBy    String?
  lastModifiedByUser User?              @relation("DocumentLastModifiedBy", fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]
  aiDrafts          AIDraft[]
  conversationSessions ConversationSession[]

  @@map("documents")
}

model DocumentVersion {
  id                    String    @id @default(uuid())
  documentId            String
  document              Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version               String
  content               String
  summary               String?
  aiDraftId             String?
  isRollback            Boolean   @default(false)
  skipImpactAnalysis    Boolean   @default(false)
  createdAt             DateTime  @default(now())

  @@unique([documentId, version])
  @@map("document_versions")
}

model AIDraft {
  id                    String              @id
  documentId            String
  document              Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name                  String
  status                AIDraftStatus       @default(pending)
  content               String
  conversationSessionId String?
  conversationSession   ConversationSession? @relation(fields: [conversationSessionId], references: [id], onDelete: SetNull)
  autoGenerated         Boolean             @default(true)
  rejectionReason       String?
  rejectedBy            String?
  associatedVersions    String[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  acceptedAt            DateTime?
  rejectedAt            DateTime?

  @@map("ai_drafts")
}

model ConversationSession {
  id                      String                      @id @default(uuid())
  documentId              String
  document                Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name                    String
  aiRole                  String
  backgroundTaskStatus    String?
  lastGeneratedAt         DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  messages                AIMessage[]
  aiDrafts                AIDraft[]
  backgroundTasks         BackgroundGenerationTask[]

  @@map("conversation_sessions")
}

model AIMessage {
  id                    String              @id @default(uuid())
  conversationSessionId String
  conversationSession   ConversationSession @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)
  role                  String
  content               String
  timestamp             DateTime            @default(now())

  @@map("ai_messages")
}

model BackgroundGenerationTask {
  id                    String              @id @default(uuid())
  conversationSessionId String
  conversationSession   ConversationSession @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)
  triggeredBy           String
  triggerMessage        String
  status                TaskStatus          @default(pending)
  generatedDraftIds     String[]
  errorMessage          String?
  createdAt             DateTime            @default(now())
  completedAt           DateTime?

  @@map("background_generation_tasks")
}

model AIDraftSequence {
  id          String   @id
  nextNumber  BigInt   @default(1)
  lastUpdated DateTime @default(now()) @updatedAt

  @@map("ai_draft_sequences")
}

// ============================================================================
// ImpactAlert BC Models
// ============================================================================

model RegenerationAlert {
  id          String        @id @default(uuid())
  nodeId      String
  node        NodeInstance  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy   AlertSource
  status      AlertStatus   @default(pending)
  createdAt   DateTime      @default(now())
  handledAt   DateTime?
  ignoredAt   DateTime?
  ignoreReason String?
  restoredAt  DateTime?

  @@map("regeneration_alerts")
}

model UpstreamClarificationAlert {
  id          String              @id @default(uuid())
  nodeId      String
  node        NodeInstance        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  actionType  UpstreamActionType
  status      AlertStatus         @default(pending)
  createdAt   DateTime            @default(now())
  handledAt   DateTime?
  ignoredAt   DateTime?
  ignoreReason String?
  restoredAt  DateTime?

  @@map("upstream_clarification_alerts")
}

// ============================================================================
// Governance / Config BC Models
// ============================================================================

model DocType {
  id               String   @id
  name             String
  code             String   @unique
  workflow         String
  category         String
  description      String
  template         String?
  supportedFormats String[]
  systemPrompt     String
  group            String?
  priority         Int
  isRequired       Boolean
  isActive         Boolean
  phases           Phase[]
  sourcesDocTypes  String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  flowTemplateNodes FlowTemplateNode[]

  @@map("doc_types")
}
model PhaseMapping {
  id            String   @id @default(uuid())
  workflowCode  String   @unique
  allowedPhases Phase[]
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("phase_mappings")
}

model AIServiceConfig {
  id                String   @id @default(uuid())
  name              String
  provider          String
  model             String
  apiKey            String
  apiEndpoint       String
  temperature       Float    @default(0.7)
  maxTokens         Int      @default(4000)
  timeoutMs         Int      @default(60000)
  retryMaxAttempts  Int      @default(3)
  retryDelayMs      Int      @default(1000)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("ai_service_configs")
}

model ArchivePolicy {
  id                      String       @id @default(uuid())
  name                    String
  archiveDaysAfterHandled Int          @default(30)
  archiveDaysAfterIgnored Int          @default(30)
  cronExpression          String       @default("0 2 * * *")
  batchSize               Int          @default(100)
  isActive                Boolean      @default(true)
  retentionDays           Int          @default(365)
  deleteAfterArchive      Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  archiveJobs             ArchiveJob[]

  @@map("archive_policies")
}

model ArchiveJob {
  id              String    @id @default(uuid())
  policyId        String
  policy          ArchivePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  status          JobStatus @default(scheduled)
  startedAt       DateTime?
  completedAt     DateTime?
  processedCount  Int       @default(0)
  archivedCount   Int       @default(0)
  errorCount      Int       @default(0)
  errorMessage    String?
  nextScheduledAt DateTime?
  createdAt       DateTime  @default(now())

  @@map("archive_jobs")
}

model User {
  id                    String    @id @default(uuid())
  username              String    @unique
  email                 String    @unique
  fullName              String
  role                  UserRole
  department            String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?
  projects              Project[]
  createdDocuments      Document[] @relation("DocumentCreatedBy")
  lastModifiedDocuments Document[] @relation("DocumentLastModifiedBy")

  @@map("users")
}

model SystemConfig {
  id          String          @id @default(uuid())
  key         String          @unique
  value       String
  dataType    ConfigDataType
  category    String?
  description String?
  isEditable  Boolean         @default(true)
  updatedAt   DateTime        @updatedAt
  updatedBy   String?

  @@map("system_configs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}